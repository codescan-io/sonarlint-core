{
  "request": {
    "method": "GET",
    "urlPath": "/api/hotspots/search.protobuf",
    "queryParameters": {
      "projectKey": {
        "equalTo": "test-project"
      },
      "branch": {
        "equalTo": "main"
      },
      "ps": {
        "equalTo": "500"
      },
      "p": {
        "equalTo": "1"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/x-protobuf"
    },
    "base64Body": ""
  },
  "metadata": {
    "note": "Recorded without the files parameter. Core's per-file call adds &files=<path>; WireMock ignores extra query parameters, so that request gets this same whole-project answer, not one filtered by file. Tests must not rely on file filtering."
  }
}
